<!doctype html>
<html>
  <head>
    <title><%= t("goodmin.title") %></title>
    <script>
      (() => {
        const storageKey = "goodmin-theme"
        const validThemes = ["light", "dark", "auto"]
        let theme = "auto"

        try {
          theme = window.localStorage.getItem(storageKey) || "auto"
        } catch (error) {}

        if (!validThemes.includes(theme)) theme = "auto"

        let resolvedTheme = theme
        if (theme === "auto") {
          resolvedTheme = window.matchMedia?.("(prefers-color-scheme: dark)")?.matches ? "dark" : "light"
        }

        document.documentElement.setAttribute("data-bs-theme", resolvedTheme)
      })()
    </script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
    <%= stylesheet_link_tag "goodmin/application", media: "all" %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" defer></script>
    <%= javascript_importmap_tags "goodmin/application", importmap: Goodmin.importmap %>

    <%= csrf_meta_tags %>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= yield :head %>
  </head>
  <body data-controller="navigation color-mode">
    <%= yield :body %>
  </body>
</html>
